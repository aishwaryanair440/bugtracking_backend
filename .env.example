# .env.example
# Copy this file to .env and fill in your real values.
# Never commit your actual .env file — it contains secrets.

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bug_tracking_system
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1d
